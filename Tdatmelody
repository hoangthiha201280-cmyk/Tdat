-- ESP
--==================================================

local function RemoveESP(player)

    local data = ESPObjects[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    ESPObjects[player] = nil
end

local function AddESP(player)

    if player == LP then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    RemoveESP(player)

    local highlight = Instance.new("Highlight")
    highlight.Name = "TDAT_PlayerESP"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = COLORS.Accent
    highlight.FillTransparency = .75
    highlight.OutlineColor = COLORS.White
    highlight.OutlineTransparency = 0
    highlight.Enabled = true
    highlight.Parent = character

    local root =
        character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")

    local billboard

    if root then

        billboard = Instance.new("BillboardGui")
        billboard.Name = "TDAT_NameESP"
        billboard.Adornee = root
        billboard.Size = UDim2.fromOffset(190,35)
        billboard.StudsOffset = Vector3.new(0,3,0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 10000
        billboard.Parent = PG

        local text = Instance.new("TextLabel")
        text.BackgroundTransparency = 1
        text.Size = UDim2.fromScale(1,1)
        text.Text = player.DisplayName .. "  @" .. player.Name
        text.TextColor3 = COLORS.White
        text.TextStrokeTransparency = 0
        text.TextStrokeColor3 = Color3.new(0,0,0)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 12
        text.Parent = billboard

    end

    ESPObjects[player] = {
        Highlight = highlight,
        Billboard = billboard
    }

end

