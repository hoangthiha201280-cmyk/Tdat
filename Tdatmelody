local function Toggle(parent,text,default,callback)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,-10,0,55)
    holder.BackgroundColor3 = COLORS.Element
    holder.Parent = parent
    Corner(holder,8)

    local textLabel = Label(
        holder,
        text,
        UDim2.new(1,-80,1,0),
        UDim2.fromOffset(14,0),
        14
    )

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.fromOffset(46,25)
    switch.Position = UDim2.new(1,-60,.5,-12)
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = holder
    Corner(switch,15)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(19,19)
    knob.Position = UDim2.fromOffset(3,3)
    knob.Parent = switch
    Corner(knob,12)

    local state = default

    local function Update()

        if state then
            switch.BackgroundColor3 = COLORS.Accent
            knob.Position = UDim2.new(1,-22,0,3)
        else
            switch.BackgroundColor3 = Color3.fromRGB(65,65,75)
            knob.Position = UDim2.fromOffset(3,3)
        end

    end

    switch.Activated:Connect(function()

        state = not state

        Update()

        if callback then
            callback(state)
        end

    end)

    Update()

    return holder
end

--==================================================
-- SLIDER
--==================================================

local function Slider(parent,text,min,max,default,callback)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,-10,0,72)
    holder.BackgroundColor3 = COLORS.Element
    holder.Parent = parent
    Corner(holder,8)

    local name = Label(
        holder,
        text,
        UDim2.new(.7,0,0,25),
        UDim2.fromOffset(14,7),
        13
    )

    local valueLabel = Label(
        holder,
        tostring(default),
        UDim2.fromOffset(70,25),
        UDim2.new(1,-85,0,7),
        13
    )

    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.TextColor3 = COLORS.Accent

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,-28,0,6)
    bar.Position = UDim2.fromOffset(14,47)
    bar.BackgroundColor3 = Color3.fromRGB(60,60,70)
    bar.Parent = holder
    Corner(bar,5)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = COLORS.Accent
    fill.Size = UDim2.fromScale(
        (default-min)/(max-min),
        1
    )
    fill.Parent = bar
    Corner(fill,5)

    local draggingSlider = false

    local function SetValue(x)

        local percent = math.clamp(
            (x-bar.AbsolutePosition.X) /
            bar.AbsoluteSize.X,
            0,
            1
        )

        local value = math.floor(
            min + ((max-min)*percent)
        )

        valueLabel.Text = tostring(value)

        fill.Size = UDim2.fromScale(percent,1)

        if callback then
            callback(value)
        end

    end

    bar.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            draggingSlider = true
            SetValue(input.Position.X)

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if not draggingSlider then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            SetValue(input.Position.X)

        end

    end)

    UserInputService.InputEnded:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            draggingSlider = false

        end

    end)

    return holder
end

